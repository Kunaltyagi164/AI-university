# ============================================================
# AI University — .gitignore
# Next.js (frontend) + Python/FastAPI (backend)
# ============================================================

# ─── Large Executables & Binaries ───────────────────────────
*.exe
*.msi
*.dmg
*.pkg
*.deb
*.rpm

# ─── Python / FastAPI (backend) ─────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.env/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Testing & coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.log

# MyPy / type checkers
.mypy_cache/
.dmypy.json
.pytype/

# ─── Environment Variables ───────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
*.env

# ─── Next.js / Node (frontend) ──────────────────────────────
node_modules/
.next/
out/
.cache/

# Build output
frontend/dist/
frontend/build/

# npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp/
.pnp.js

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ─── IDEs & Editors ─────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS Files ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Databases & Secrets ────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.pem
*.key
*.cert
secrets/

# ─── Misc ───────────────────────────────────────────────────
*.bak
*.tmp
*.swp
